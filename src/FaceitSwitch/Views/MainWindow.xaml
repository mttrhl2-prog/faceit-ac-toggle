<ui:FluentWindow x:Class="FaceitSwitch.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FACEIT Switch" Width="1000" Height="790" MinWidth="940" MinHeight="740"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round" WindowBackdropType="None"
    Background="#141517" Foreground="{StaticResource SwitchText}" FontFamily="Segoe UI"
    Loaded="WindowLoaded" Closing="WindowClosing">
  <Grid>
    <Grid.Background>
      <RadialGradientBrush Center="0.12,0.2" GradientOrigin="0.12,0.2" RadiusX="0.8" RadiusY="0.65">
        <GradientStop Color="#27181D" Offset="0" /><GradientStop Color="#141517" Offset="0.75" />
      </RadialGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Height="36" ShowMinimize="True" ShowMaximize="True" ShowClose="True" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,12">
      <StackPanel>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Path Grid.Column="0" Data="M 0,24 L 31,24 L 43,6 L 43,43 Z" Fill="{StaticResource SwitchAccent}" Width="44" Height="44" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,12,0" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="FACEIT Switch" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="FACEIT profile and security manager" FontSize="14" Foreground="{StaticResource SwitchMuted}" Margin="0,1,0,8" />
            <Border Style="{StaticResource StateBadge}" CornerRadius="5" Padding="10,4" HorizontalAlignment="Left" ToolTip="Configured state, read from Windows. Effective runtime state is shown below.">
              <TextBlock Style="{StaticResource StateBadgeText}" FontSize="12"><Run Text="Current state:  " /><Run Text="{Binding CurrentState, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            </Border>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource ActionButton}" Padding="10,6" VerticalAlignment="Bottom" Command="{Binding RefreshCommand}" ToolTip="Rescan Windows without changing settings" AutomationProperties.Name="Refresh configuration" Content="↻" FontSize="20" />
        </Grid>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource EnabledProfileCard}" ToolTip="Enabled profile target. FACEIT compatibility and runtime protections must be checked after restart.">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="32" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="FACEIT ENABLED" FontSize="20" FontWeight="Bold" />
                  <TextBlock Text="Restores the full FACEIT Anti-Cheat configuration." FontSize="12" Foreground="{StaticResource SwitchMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
              <Border Height="1" Background="{StaticResource SwitchBorder}" Margin="0,12,0,8" />
              <TextBlock Style="{StaticResource ProfileBullet}"><Run Text="●  " Foreground="{StaticResource SwitchMuted}" /><Run Text="FACEIT ready" /></TextBlock>
              <TextBlock Style="{StaticResource ProfileBullet}"><Run Text="●  " Foreground="{StaticResource SwitchMuted}" /><Run Text="Security protections enabled" /></TextBlock>
              <Button Command="{Binding EnableProfileCommand}" Style="{StaticResource EnabledProfileAction}" Margin="0,12,0,0" Content="ENABLE FACEIT  →" Height="42" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource DisabledProfileCard}" ToolTip="Disabled profile target. Loaded FACEIT kernel drivers remain loaded until restart.">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons" FontSize="32" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="FACEIT DISABLED" FontSize="20" FontWeight="Bold" />
                  <TextBlock Text="Disables FACEIT and related Windows security features." FontSize="12" Foreground="{StaticResource SwitchMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
              <Border Height="1" Background="{StaticResource SwitchBorder}" Margin="0,12,0,8" />
              <TextBlock Style="{StaticResource ProfileBullet}"><Run Text="×  " Foreground="{StaticResource SwitchMuted}" /><Run Text="Non-FACEIT mode" /></TextBlock>
              <TextBlock Style="{StaticResource ProfileBullet}"><Run Text="×  " Foreground="{StaticResource SwitchMuted}" /><Run Text="Security protections disabled" /></TextBlock>
              <Button Command="{Binding DisableProfileCommand}" Style="{StaticResource DisabledProfileAction}" Margin="0,12,0,0" Content="DISABLE FACEIT  →" Height="42" />
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Text="Security" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding Settings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#1D1E20" BorderBrush="#2A2B30" BorderThickness="1" CornerRadius="8" Margin="0,0,0,7" Padding="16,9">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="26" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="15" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource SwitchMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Visibility="{Binding HasStateLabel, Converter={StaticResource BoolVisibility}}" Foreground="#E4BD7B" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" ToolTip="{Binding Detail}" />
                  <Button Grid.Column="3" Style="{StaticResource SettingToggle}" Command="{Binding ToggleCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding RuntimeSummary}" TextWrapping="Wrap" Foreground="{StaticResource SwitchMuted}" FontSize="11" Margin="2,3,0,0" ToolTip="{Binding RuntimeDetail}" />
        <TextBlock Text="{Binding DependencyWarning}" Visibility="{Binding HasDependencyWarning, Converter={StaticResource BoolVisibility}}" Foreground="#E4BD7B" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap" />
        <Border Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="#29292D" />
              <Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Background" Value="#442127" /></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource SwitchBorder}" BorderThickness="0,1,0,0" Padding="24,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="ⓘ" FontSize="22" Foreground="{StaticResource SwitchMuted}" Margin="0,0,12,0" />
          <TextBlock Text="{Binding FooterText}" FontSize="12" VerticalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SwitchMuted}" /><Style.Triggers><DataTrigger Binding="{Binding RestartRequired}" Value="True"><Setter Property="Foreground" Value="{StaticResource SwitchAccent}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <Button Grid.Column="1" Content="↻   Restart Windows" Command="{Binding RestartCommand}" Style="{StaticResource ActionButton}" Padding="16,8" FontWeight="Normal" />
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
